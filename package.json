{
  "name": "3dcad-studio",
  "version": "3.2.0",
  "private": true,
  "description": "パラメトリック 3D CAD (Inventor スタイルのワークフロー、STEP 互換)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "app": "vite build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs && node scripts/e2e-recovery.mjs && node scripts/e2e-formats.mjs && node scripts/e2e-naming.mjs && node scripts/e2e-rebuild.mjs && node scripts/e2e-measure.mjs && node scripts/e2e-viewer.mjs && node scripts/e2e-asmview.mjs && node scripts/e2e-view.mjs",
    "e2e:measure": "node scripts/e2e-measure.mjs",
    "e2e:asmview": "node scripts/e2e-asmview.mjs",
    "e2e:view": "node scripts/e2e-view.mjs",
    "e2e:rebuild": "node scripts/e2e-rebuild.mjs",
    "bench:rebuild": "node scripts/bench-rebuild.mjs",
    "e2e:naming": "node scripts/e2e-naming.mjs",
    "e2e:recovery": "node scripts/e2e-recovery.mjs",
    "e2e:formats": "node scripts/e2e-formats.mjs",
    "e2e:viewer": "node scripts/e2e-viewer.mjs",
    "bench:startup": "node scripts/bench-startup.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "katex": "^0.16.11",
    "opencascade.js": "^2.0.0-beta.b5ff984",
    "playwright": "^1.63.0",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "web-ifc": "^0.0.78"
  },
  "main": "electron/main.cjs",
  "productName": "3DCAD Studio",
  "author": "3DCAD Studio",
  "build": {
    "appId": "jp.hisol.cad3d.studio",
    "productName": "3DCAD Studio",
    "copyright": "Copyright © 2026 3DCAD Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "3dcp",
        "name": "3DCAD Part",
        "description": "3DCAD Studio パーツ",
        "role": "Editor",
        "icon": "icon"
      },
      {
        "ext": "3dca",
        "name": "3DCAD Assembly",
        "description": "3DCAD Studio アセンブリ",
        "role": "Editor",
        "icon": "icon"
      },
      {
        "ext": [
          "stp",
          "step"
        ],
        "name": "3DCAD Viewer STEP",
        "description": "STEP 3D モデル (3DCAD Viewer で表示)",
        "role": "Viewer",
        "icon": "icon"
      },
      {
        "ext": [
          "igs",
          "iges"
        ],
        "name": "3DCAD Viewer IGES",
        "description": "IGES 3D モデル (3DCAD Viewer で表示)",
        "role": "Viewer",
        "icon": "icon"
      },
      {
        "ext": [
          "stl"
        ],
        "name": "3DCAD Viewer STL",
        "description": "STL メッシュ (3DCAD Viewer で表示)",
        "role": "Viewer",
        "icon": "icon"
      },
      {
        "ext": [
          "obj"
        ],
        "name": "3DCAD Viewer OBJ",
        "description": "OBJ メッシュ (3DCAD Viewer で表示)",
        "role": "Viewer",
        "icon": "icon"
      },
      {
        "ext": [
          "3mf"
        ],
        "name": "3DCAD Viewer 3MF",
        "description": "3MF 3D プリント モデル (3DCAD Viewer で表示)",
        "role": "Viewer",
        "icon": "icon"
      },
      {
        "ext": [
          "glb",
          "gltf"
        ],
        "name": "3DCAD Viewer glTF",
        "description": "glTF 3D モデル (3DCAD Viewer で表示)",
        "role": "Viewer",
        "icon": "icon"
      },
      {
        "ext": [
          "ply"
        ],
        "name": "3DCAD Viewer PLY",
        "description": "PLY 点群 / メッシュ (3DCAD Viewer で表示)",
        "role": "Viewer",
        "icon": "icon"
      },
      {
        "ext": [
          "e57"
        ],
        "name": "3DCAD Viewer E57",
        "description": "E57 点群 (3DCAD Viewer で表示)",
        "role": "Viewer",
        "icon": "icon"
      },
      {
        "ext": [
          "ifc"
        ],
        "name": "3DCAD Viewer IFC",
        "description": "IFC 建築モデル (3DCAD Viewer で表示)",
        "role": "Viewer",
        "icon": "icon"
      },
      {
        "ext": [
          "dxf"
        ],
        "name": "3DCAD Viewer DXF",
        "description": "DXF 図面 (3DCAD Viewer で表示)",
        "role": "Viewer",
        "icon": "icon"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "3DCAD Studio",
      "artifactName": "3DCAD-Studio-Setup-${version}.${ext}",
      "installerLanguages": [
        "ja_JP"
      ],
      "language": "1041",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "artifactName": "3DCAD-Studio-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "maintainer": "3DCAD Studio",
      "artifactName": "3DCAD-Studio-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "compression": "maximum",
    "electronLanguages": [
      "ja",
      "en-US"
    ]
  },
  "desktopName": "3dcad-studio.desktop",
  "dependencies": {
    "clipper-lib": "^6.4.2"
  }
}
